{
  "expo": {
    "name": "Stokit",
    "slug": "PantryPal",
    "version": "1.0.0",
    "owner": "qadeeradil14-alt",
    "orientation": "portrait",
    "scheme": "pantrypal",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon-dark.png",
    "backgroundColor": "#15110C",
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/icon-dark.png",
      "bundleIdentifier": "com.hewadadil.pantrypal",
      "buildNumber": "107",
      "deploymentTarget": "16.4",
      "appleTeamId": "4AJ8TH5QF7",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "$(PRODUCT_MODULE_NAME).SceneDelegate"
              }
            ]
          }
        },
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Stokit uses your location to remind you when you arrive at a store where you have items.",
        "NSLocationWhenInUseUsageDescription": "Stokit uses your location to find nearby grocery stores.",
        "NSLocationAlwaysUsageDescription": "Stokit uses background location to remind you when you arrive at a store."
      }
    },
    "android": {
      "package": "com.hewadadil.pantrypal",
      "adaptiveIcon": {
        "backgroundColor": "#E6D6C0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Stokit needs your location to find grocery stores near you.",
          "locationAlwaysAndWhenInUsePermission": "Stokit uses background location to remind you when you arrive at a store where you have items.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Stokit needs photo access to attach receipt images.",
          "cameraPermission": "Stokit needs camera access to scan receipts."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon-dark.png",
          "color": "#D4874E",
          "sounds": []
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1117",
          "resizeMode": "contain"
        }
      ],
      "./plugins/with-widget-version",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.hewadadil.pantrypal.widgets",
          "groupIdentifier": "group.com.hewadadil.pantrypal",
          "widgets": [
            {
              "name": "LowStockWidget",
              "displayName": "Low Stock",
              "description": "See what your household needs at a glance.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryRectangular",
                "accessoryInline"
              ]
            },
            {
              "name": "QuickScanWidget",
              "displayName": "Quick Scan",
              "description": "Open Stokit to scan a receipt.",
              "supportedFamilies": [
                "systemSmall"
              ]
            }
          ]
        }
      ],
      "./plugins/with-ios-scene-lifecycle",
      [
        "./plugins/with-ios-xcode27-build-settings",
        {
          "buildNumber": "107",
          "deploymentTarget": "16.4"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3d19b1e1-1003-4e33-8929-2d27e7fd7f3c"
      }
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/3d19b1e1-1003-4e33-8929-2d27e7fd7f3c",
      "fallbackToCacheTimeout": 10000,
      "checkAutomatically": "ON_LOAD",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
