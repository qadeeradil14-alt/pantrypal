# Stokit V2 — environment variables
# Copy to .env and fill in your values. Never commit .env.

# ── AUTH ───────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── FREE (set up now, no credit card) ─────────────────────────────────────────
#
# Store logos — real brand marks for Walmart, Aldi, Whole Foods, etc.
# Register free (2 min) at https://logo.dev → copy your public token below.
# Without this, known stores fall back to branded letter chips (still works).
EXPO_PUBLIC_LOGODEV_TOKEN=pk_your_token_here
#
# Receipt OCR — 25,000 scans/month free.
# Sign up (30 sec): https://ocr.space/ocrapi → copy your API key below.
EXPO_PUBLIC_OCR_SPACE_KEY=your_ocr_space_key_here

# Proxy endpoint for OpenAI GPT-4o Vision receipt scanning
EXPO_PUBLIC_RECEIPT_SCAN_URL=https://your-project.supabase.co/functions/v1/scan-receipt

# ── PREMIUM UPGRADE (add before App Store release) ────────────────────────────
#
# Google Cloud API key — enables:
#   • Google Places store discovery (replaces OpenStreetMap, richer data)
#   • Google Cloud Vision receipt OCR (replaces ocr.space, better accuracy)
# When set, both services upgrade automatically with zero code changes.
# Create at: https://console.cloud.google.com
# Enable: Places API + Cloud Vision API
EXPO_PUBLIC_GOOGLE_API_KEY=AIza_your_google_key_here
