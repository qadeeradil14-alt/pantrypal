{
  "cli": {
    "version": ">= 19.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true",
        "EAS_PROJECT_ROOT": "apps/stokit-v2"
      }
    },
    "redesignTest": {
      "distribution": "internal",
      "channel": "shopping-redesign-test",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "redesign",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true",
        "EAS_PROJECT_ROOT": "apps/stokit-v2"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6774653348",
        "ascApiKeyPath": "./secrets/AuthKey_SY6372R52T.p8",
        "ascApiKeyIssuerId": "7041f663-a114-4172-8194-c20fca3a62fe",
        "ascApiKeyId": "SY6372R52T"
      }
    }
  }
